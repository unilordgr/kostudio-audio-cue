{
  "name": "kostudio-audio-cue",
  "version": "1.4.0",
  "description": "Kostudio Audio Cue — Live Performance Sound Manager",
  "author": "needitcreative.com",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/unilordgr/kostudio-audio-cue.git"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist-win": "electron-builder --win --publish never",
    "dist-mac": "electron-builder --mac --publish never",
    "test": "node tests/run.js"
  },
  "build": {
    "appId": "com.kostudio.audiocue",
    "productName": "Kostudio Audio Cue",
    "copyright": "Copyright © 2026 needitcreative.com",
    "icon": "build/icons/icon.png",
    "files": [
      "main.js",
      "preload.js",
      "remote.js",
      "remote.html",
      "index.html",
      "build/icons/256x256.png"
    ],
    "win": {
      "icon": "build/icons/256x256.png",
      "artifactName": "Kostudio-Audio-Cue-${arch}.${ext}",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "icon": "build/icons/icon.png",
      "artifactName": "Kostudio-Audio-Cue-${arch}.${ext}",
      "identity": null,
      "hardenedRuntime": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.music"
    },
    "dmg": {
      "title": "Kostudio Audio Cue ${version}${arch}",
      "background": null
    }
  },
  "devDependencies": {
    "electron": "^43.7.5",
    "electron-builder": "^26.15.3",
    "playwright": "1.56.1"
  }
}
